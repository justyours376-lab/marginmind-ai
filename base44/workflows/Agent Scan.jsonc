{
  "description": "Every 2 hours: syncs supplier stock to eBay, applies the margin floor to prices, and re-ranks suppliers by incidents",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agent_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agentScan",
            "args": {
              "all": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Stock sync, repricing, supplier ranking"
          }
        }
      }
    ]
  },
  "name": "Agent Scan",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}