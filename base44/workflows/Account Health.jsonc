{
  "description": "Every day 6:00 AM (America/Phoenix): saves a seller health snapshot; critical TDR pauses new listing approvals",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "account_health",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "take_snapshot": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "accountHealth",
            "args": {
              "all": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Seller health snapshot"
          }
        }
      }
    ]
  },
  "name": "Account Health",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/Phoenix",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}