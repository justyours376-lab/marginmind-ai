{
  "description": "Every Monday 8:00 AM, tells sellers the new trend scan is ready in Chat",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_trend_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "announce_scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyJobs",
            "args": {
              "job": "scan"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Announce trend scan"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Weekly Trend Scan"
}