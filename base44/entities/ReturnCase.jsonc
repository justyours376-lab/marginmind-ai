{
  "name": "ReturnCase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Seller this case belongs to (set by the eBay notification intake)"
    },
    "order_ref": {
      "type": "string",
      "description": "Order id"
    },
    "product_name": {
      "type": "string"
    },
    "ebay_item_id": {
      "type": "string"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "return",
        "item_not_received",
        "buyer_message",
        "feedback"
      ]
    },
    "ebay_case_id": {
      "type": "string"
    },
    "buyer_message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responding",
        "resolved",
        "escalated"
      ],
      "default": "open"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "3 business days after the case was received"
    },
    "ai_suggested_reply": {
      "type": "string"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_ref",
    "case_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}