{
  "name": "ReturnCase",
  "type": "object",
  "properties": {
    "order_ref": {
      "type": "string",
      "description": "Order id"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "return",
        "item_not_received",
        "buyer_message",
        "feedback"
      ]
    },
    "ebay_case_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responding",
        "resolved",
        "escalated"
      ],
      "default": "open"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggested_reply": {
      "type": "string"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_ref",
    "case_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}