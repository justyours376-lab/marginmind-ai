{
  "name": "Order",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "sell_price": {
      "type": "number"
    },
    "unit_profit": {
      "type": "number"
    },
    "returns_reserve_pct": {
      "type": "number"
    },
    "realized_profit": {
      "type": "number",
      "default": 0
    },
    "realized_reserve": {
      "type": "number",
      "default": 0
    },
    "units_sold": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_approval",
        "payment_failed",
        "ordered",
        "shipped",
        "delivered",
        "sold",
        "at_risk"
      ],
      "default": "awaiting_approval"
    },
    "previous_status": {
      "type": "string",
      "description": "Status the order had before it was marked at_risk"
    },
    "risk_reason": {
      "type": "string",
      "description": "Why the order is at_risk, e.g. supplier_out_of_stock"
    },
    "demo": {
      "type": "boolean"
    },
    "supplier_paid": {
      "type": "boolean",
      "default": false
    },
    "tracking_uploaded": {
      "type": "boolean",
      "default": false
    },
    "cash_flow_status": {
      "type": "string",
      "enum": [
        "float_out",
        "settled"
      ]
    }
  },
  "required": [
    "product_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}