{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string",
      "description": "Name of the product this supplier can supply (matches Product.name)"
    },
    "name": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "US for the US group; any other country puts the supplier in the view-only non-US group"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "delivery_days_us": {
      "type": "number"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True only after the US wholesaler/distributor has been verified"
    },
    "ebay_registered": {
      "type": "boolean",
      "description": "Must be explicitly true for the US group (missing = excluded)"
    },
    "ebay_listable": {
      "type": "boolean",
      "description": "Must be explicitly true: the item is eligible for eBay listing (missing = excluded)"
    },
    "ebay_restricted": {
      "type": "boolean",
      "description": "Must be explicitly false for the US group: true means eBay-restricted / VeRO (missing = excluded)"
    },
    "stock_available": {
      "type": "number",
      "description": "Units the supplier currently has in stock for this product. Empty = unknown (no out-of-stock check)."
    },
    "stock_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When stock_available was last confirmed"
    },
    "years_in_business": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "response_rate": {
      "type": "number"
    },
    "ontime_rate": {
      "type": "number"
    },
    "reliability_score": {
      "type": "number"
    },
    "business_type": {
      "type": "string"
    },
    "policy_safe": {
      "type": "boolean"
    },
    "resale_certificate_ok": {
      "type": "boolean"
    },
    "us_state_registered": {
      "type": "string"
    },
    "ein_verified": {
      "type": "boolean"
    },
    "wire_only_redflag": {
      "type": "boolean"
    },
    "last_feed_sync": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}