{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "sale",
        "low_stock",
        "marketing",
        "report",
        "scan",
        "security",
        "stock_risk",
        "return",
        "agreement"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "normal",
        "critical"
      ],
      "default": "normal"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "title_key": {
      "type": "string",
      "description": "Message key for the title; the app re-renders it in the selected language"
    },
    "msg_key": {
      "type": "string",
      "description": "Message key for the body"
    },
    "vars": {
      "type": "object",
      "description": "Values filled into the title and body templates"
    },
    "link": {
      "type": "string",
      "description": "In-app route (with ?focus=<element id>) of the record this notification is about"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}