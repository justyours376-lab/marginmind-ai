{
  "name": "AuditLog",
  "type": "object",
  "description": "Append-only: records can be created and read, never edited or deleted.",
  "properties": {
    "action": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "append_only_no_one"
      }
    },
    "delete": false
  }
}