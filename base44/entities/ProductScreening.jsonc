{
  "name": "ProductScreening",
  "type": "object",
  "properties": {
    "product_name": {
      "type": "string"
    },
    "niche": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "excluded",
        "manual_review"
      ]
    },
    "reasons": {
      "type": "string",
      "description": "Comma separated reject reasons: ebay:<category id>, source_retail, no_agreement, vero_unauthorized, dispatch_missing, dispatch_slow, text_claim, not_english"
    },
    "policy_version": {
      "type": "string"
    },
    "product_id": {
      "type": "string",
      "description": "Set only for passed items that were saved as a Product"
    },
    "supplier_ref": {
      "type": "string",
      "description": "Supplier id of an order held for manual review (used when the hold is approved)"
    },
    "quantity": {
      "type": "number",
      "description": "Order quantity of an order held for manual review"
    }
  },
  "required": [
    "product_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}