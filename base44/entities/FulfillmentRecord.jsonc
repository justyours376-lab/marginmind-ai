{
  "name": "FulfillmentRecord",
  "type": "object",
  "properties": {
    "order_ref": {
      "type": "string",
      "description": "Order id"
    },
    "supplier_order_id": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "uploaded_to_ebay": {
      "type": "boolean",
      "default": false
    },
    "uploaded_within_handling_time": {
      "type": "boolean"
    },
    "shipped_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "order_ref"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}