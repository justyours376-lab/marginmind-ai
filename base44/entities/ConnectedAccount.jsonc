{
  "name": "ConnectedAccount",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "ebay",
        "shopify",
        "amazon",
        "alibaba",
        "1688",
        "dhgate",
        "made_in_china",
        "payment"
      ]
    },
    "encrypted_credentials": {
      "type": "string",
      "description": "AES-GCM encrypted JSON of API keys/OAuth tokens"
    },
    "hint": {
      "type": "string",
      "description": "Masked display hint"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ],
      "default": "connected"
    },
    "connection_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only after a real call to the provider succeeded with the saved credentials"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the provider connection was last verified or synced"
    },
    "scopes_granted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OAuth scopes the provider granted"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the saved access token expires"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}