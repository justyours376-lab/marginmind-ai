{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "spend_cap": {
      "type": "number",
      "description": "Max order total (USD) before extra confirmation",
      "default": 200
    },
    "language": {
      "type": "string",
      "description": "UI language: ne, hi or en"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ne",
        "hi",
        "en"
      ],
      "default": "ne"
    },
    "notification_email": {
      "type": "string"
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "returns_reserve": {
      "type": "number",
      "description": "Returns reserve percent of sell price",
      "default": 5
    }
  },
  "required": [
    "role"
  ]
}