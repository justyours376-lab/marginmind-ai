{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "spend_cap": {
      "type": "number",
      "description": "Max order total (USD) before extra confirmation",
      "default": 200
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ne",
        "hi",
        "en"
      ],
      "default": "ne",
      "description": "App language for screens, notifications and emails (the only language field). Listing content is always English."
    },
    "notification_email": {
      "type": "string"
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "returns_reserve": {
      "type": "number",
      "description": "Returns reserve percent of sell price",
      "default": 5
    },
    "margin_floor": {
      "type": "number",
      "description": "Minimum estimated margin % per listing; below it the repricing guard raises the price or delists",
      "default": 12
    }
  },
  "required": [
    "role"
  ]
}