{
  "name": "Listing",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "ended"
      ],
      "default": "live"
    }
  },
  "required": [
    "title"
  ]
}