{
  "name": "Listing",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string"
    },
    "handling_days": {
      "type": "number",
      "description": "Listing handling time in business days. Always set from Agreement.dispatch_time_days, never lower."
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "ended",
        "paused"
      ],
      "default": "live"
    },
    "paused_reason": {
      "type": "string",
      "description": "Why the listing was paused, e.g. supplier_out_of_stock"
    },
    "margin": {
      "type": "number",
      "description": "Estimated margin % at the current price and supplier cost (set by the repricing guard)"
    },
    "supplier_cost": {
      "type": "number",
      "description": "Supplier cost used for the last margin calculation"
    },
    "stock_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stock sync first saw the supplier at zero"
    },
    "ebay_zeroed": {
      "type": "boolean",
      "description": "True once the eBay quantity was set to zero"
    },
    "ebay_note": {
      "type": "string",
      "description": "Result code of the last eBay quantity update"
    },
    "end_reason": {
      "type": "string",
      "description": "Why the listing was ended, e.g. margin_below_floor"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}