{
  "name": "Listing",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "ended",
        "paused"
      ],
      "default": "live"
    },
    "paused_reason": {
      "type": "string",
      "description": "Why the listing was paused, e.g. supplier_out_of_stock"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}